# คัดลอกไฟล์นี้เป็น .env.local แล้วเติมค่าจริง (อย่า commit .env.local)

# NextAuth (dev รันที่พอร์ต 3001 — ต้องตรงกับ redirect URI ใน Google OAuth)
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=

# Google OAuth (Google Cloud Console → Credentials → OAuth client ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API (aistudio.google.com/apikey)
GEMINI_API_KEY=

# Email แจ้งเตือน (ไม่บังคับ) — ถ้าไม่ตั้ง จะแจ้งเตือนเฉพาะในเว็บ
# วิธีที่ 1 (แนะนำ): SMTP ส่งหาใครก็ได้ ไม่ต้องมีโดเมน
#   Gmail → SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=อีเมล, SMTP_PASS=App Password (ไม่ใช่รหัส Gmail ปกติ)
#   สร้าง App Password: บัญชี Google → Security → เปิด 2-Step Verification → App passwords
#   *ที่อยู่ใน EMAIL_FROM ต้องตรงกับ SMTP_USER (บัญชีเดียวกัน)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="TaskHub <your-gmail@gmail.com>"

# วิธีที่ 2 (ทางเลือก): Resend HTTP API (โหมดฟรีต้อง verify domain ถึงส่งหาคนอื่นได้)
RESEND_API_KEY=
