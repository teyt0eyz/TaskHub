# คัดลอกไฟล์นี้เป็น .env.local แล้วเติมค่าจริง (อย่า commit .env.local)

# NextAuth (dev รันที่พอร์ต 3001 — ต้องตรงกับ redirect URI ใน Google OAuth)
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=

# Google OAuth (Google Cloud Console → Credentials → OAuth client ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API (aistudio.google.com/apikey)
GEMINI_API_KEY=
